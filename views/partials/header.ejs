<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Meal Reservation</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
</head>
<body class="<%= user ? 'app-body ' + user.role + '-body' : 'public-body' %>">
<% if (user) { %>
  <div class="app-shell">
    <aside class="app-sidebar" id="appSidebar">
      <div class="sidebar-brand">
        <div class="brand-mark"><i class="bi bi-cup-hot-fill"></i></div>
        <div>
          <div class="brand-title">Meal Reservation</div>
          <div class="brand-subtitle"><%= user.role === 'admin' ? 'Admin Portal' : 'Student Portal' %></div>
        </div>
      </div>

      <div class="sidebar-section-label">WORKSPACE</div>
      <nav class="sidebar-nav">
        <% if (user.role === 'student') { %>
          <a class="sidebar-link" href="/student/dashboard"><i class="bi bi-grid-1x2-fill"></i><span>Dashboard</span></a>
          <a class="sidebar-link" href="/student/meals"><i class="bi bi-egg-fried"></i><span>Meals</span></a>
          <a class="sidebar-link" href="/student/reservations"><i class="bi bi-calendar-check"></i><span>My Reservations</span></a>
          <a class="sidebar-link" href="/student/feedback"><i class="bi bi-chat-heart"></i><span>Feedback</span></a>
          <a class="sidebar-link" href="/student/profile"><i class="bi bi-person-circle"></i><span>Profile</span></a>
        <% } else { %>
          <a class="sidebar-link" href="/admin/dashboard"><i class="bi bi-grid-1x2-fill"></i><span>Dashboard</span></a>
          <a class="sidebar-link" href="/admin/meals"><i class="bi bi-egg-fried"></i><span>Meals</span></a>
          <a class="sidebar-link" href="/admin/reservations"><i class="bi bi-journal-text"></i><span>Reservations</span></a>
          <a class="sidebar-link" href="/admin/attendance"><i class="bi bi-person-check"></i><span>Attendance</span></a>
          <a class="sidebar-link" href="/admin/reports"><i class="bi bi-bar-chart-line"></i><span>Reports</span></a>
          <a class="sidebar-link" href="/admin/feedback"><i class="bi bi-chat-heart"></i><span>Feedback</span></a>
        <% } %>
      </nav>

      <div class="sidebar-spacer"></div>
      <div class="sidebar-user">
        <div class="avatar"><%= (user.name || 'U').charAt(0).toUpperCase() %></div>
        <div class="sidebar-user-info">
          <strong><%= user.name %></strong>
          <small><%= user.role === 'admin' ? 'Administrator' : 'Student' %></small>
        </div>
        <a href="/logout" class="sidebar-logout" title="Logout"><i class="bi bi-box-arrow-right"></i></a>
      </div>
    </aside>

    <div class="app-main">
      <header class="topbar">
        <button class="mobile-menu-btn" type="button" data-sidebar-toggle><i class="bi bi-list"></i></button>
        <div>
          <div class="topbar-kicker"><%= user.role === 'admin' ? 'HOSTEL MANAGEMENT' : 'STUDENT PORTAL' %></div>
          <div class="topbar-title"><%= title %></div>
        </div>
        <div class="topbar-profile">
          <div class="avatar avatar-sm"><%= (user.name || 'U').charAt(0).toUpperCase() %></div>
          <div class="d-none d-sm-block">
            <strong><%= user.name %></strong>
            <small><%= user.role === 'admin' ? 'Administrator' : 'Student' %></small>
          </div>
        </div>
      </header>
      <main class="app-content container-fluid">
<% } else { %>
  <nav class="navbar navbar-expand-lg public-navbar">
    <div class="container">
      <a class="navbar-brand fw-bold" href="/"><i class="bi bi-cup-hot-fill me-2"></i>Meal Reservation</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-1">
          <li class="nav-item"><a class="nav-link" href="/">Home</a></li>
          <li class="nav-item"><a class="nav-link" href="/register">Student</a></li>
          <li class="nav-item"><a class="nav-link" href="/admin/register">Admin</a></li>
          <li class="nav-item ms-lg-2"><a class="nav-link landing-login-link" href="/login">Login</a></li>
          <li class="nav-item"><a class="nav-link landing-register-link" href="/register">Register</a></li>
        </ul>
      </div>
    </div>
  </nav>
  <main class="public-main">
<% } %>

<% if (success && success.length) { %>
  <% success.forEach(function(msg) { %>
    <div class="alert alert-success alert-dismissible fade show modern-alert" role="alert">
      <i class="bi bi-check-circle-fill me-2"></i><%= msg %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% }); %>
<% } %>
<% if (error && error.length) { %>
  <% error.forEach(function(msg) { %>
    <div class="alert alert-danger alert-dismissible fade show modern-alert" role="alert">
      <i class="bi bi-exclamation-circle-fill me-2"></i><%= msg %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% }); %>
<% } %>

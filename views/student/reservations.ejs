<%- include('../partials/header') %>

<h2 class="mb-4"><i class="bi bi-journal-bookmark me-2"></i>My Reservations</h2>

<div class="card border-0 shadow-sm">
  <div class="card-body p-0">
    <% if (reservations.length === 0) { %>
      <p class="text-muted text-center py-5 mb-0">No reservations yet. <a href="/student/meals">Book your first meal</a></p>
    <% } else { %>
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead class="table-light">
            <tr>
              <th>Meal</th>
              <th>Date</th>
              <th>Session</th>
              <th>Guests</th>
              <th>Total Meals</th>
              <th>Status</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            <% reservations.forEach(function(r) { %>
              <tr>
                <td><%= r.meal ? r.meal.name : 'N/A' %></td>
                <td><%= new Date(r.date).toLocaleDateString() %></td>
                <td><span class="badge session-<%= r.session %>"><%= r.session %></span></td>
                <td><%= r.guestCount %></td>
                <td><%= r.totalMeals %></td>
                <td>
                  <% if (r.status === 'confirmed') { %>
                    <span class="badge bg-success">Confirmed</span>
                  <% } else if (r.status === 'cancelled') { %>
                    <span class="badge bg-danger">Cancelled</span>
                  <% } else { %>
                    <span class="badge bg-secondary"><%= r.status %></span>
                  <% } %>
                </td>
                <td>
                  <% if (r.status === 'confirmed' && new Date(r.date) >= new Date(new Date().setHours(0,0,0,0))) { %>
                    <form action="/student/reservations/<%= r._id %>/cancel" method="POST" class="d-inline" onsubmit="return confirm('Cancel this reservation?')">
                      <button type="submit" class="btn btn-sm btn-outline-danger">Cancel</button>
                    </form>
                  <% } else { %>
                    <span class="text-muted">—</span>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>

<%- include('../partials/header') %>

<div class="page-intro mb-4">
  <div>
    <div class="page-kicker">STUDENT PROFILE</div>
    <h2 class="mb-1">Your Profile</h2>
    <p class="text-muted mb-0">Manage the details used for your meal reservation account.</p>
  </div>
</div>

<div class="row g-4">
  <div class="col-lg-4">
    <div class="profile-card text-center">
      <div class="profile-avatar"><%= (profile.name || 'U').charAt(0).toUpperCase() %></div>
      <h4 class="mt-3 mb-1"><%= profile.name %></h4>
      <div class="text-muted mb-3">Student</div>
      <div class="profile-pill"><i class="bi bi-mortarboard me-2"></i><%= profile.studentId || 'Student ID not set' %></div>
      <div class="profile-pill"><i class="bi bi-envelope me-2"></i><%= profile.email %></div>
    </div>
  </div>
  <div class="col-lg-8">
    <div class="modern-card bg-white">
      <div class="card-header bg-white p-4"><h5 class="fw-bold mb-1">Personal Information</h5><div class="small text-muted">Update your basic account details.</div></div>
      <div class="card-body p-4">
        <form method="POST" action="/student/profile">
          <div class="row g-3">
            <div class="col-md-6"><label class="form-label">Full Name</label><input class="form-control" name="name" value="<%= profile.name %>" required></div>
            <div class="col-md-6"><label class="form-label">Student ID</label><input class="form-control" name="studentId" value="<%= profile.studentId || '' %>"></div>
            <div class="col-md-6"><label class="form-label">Email</label><input class="form-control" value="<%= profile.email %>" disabled></div>
            <div class="col-md-6"><label class="form-label">Phone</label><input class="form-control" name="phone" value="<%= profile.phone || '' %>"></div>
          </div>
          <div class="mt-4 d-flex gap-2">
            <button class="btn btn-primary px-4" type="submit"><i class="bi bi-check2-circle me-2"></i>Save Changes</button>
            <a class="btn btn-outline-secondary" href="/student/dashboard">Cancel</a>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>

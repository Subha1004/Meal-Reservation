<%- include('../partials/header') %>

<%
  const sessionSummary = { breakfast: { reservations: 0, meals: 0 }, lunch: { reservations: 0, meals: 0 }, dinner: { reservations: 0, meals: 0 } };
  todayReservations.forEach(function(r) {
    const key = r.session && sessionSummary[r.session] ? r.session : 'lunch';
    sessionSummary[key].reservations += 1;
    sessionSummary[key].meals += r.totalMeals || (1 + (r.guestCount || 0));
  });
  const busiestSession = Object.keys(sessionSummary).sort(function(a,b) { return sessionSummary[b].meals - sessionSummary[a].meals; })[0];
  const confirmedCount = todayReservations.filter(function(r) { return r.status === 'confirmed'; }).length;
  const completedCount = todayReservations.filter(function(r) { return r.status === 'completed'; }).length;
%>

<div class="dashboard-hero mb-4">
  <div class="row align-items-center g-4">
    <div class="col-lg-8">
      <div class="small text-uppercase fw-bold opacity-75 mb-2">Today at a glance</div>
      <h2 class="mb-2">Good <%= new Date().getHours() < 12 ? 'Morning' : (new Date().getHours() < 17 ? 'Afternoon' : 'Evening') %>, Admin 👋</h2>
      <p class="mb-0">A quick view of today's meal demand, reservations and kitchen readiness.</p>
    </div>
    <div class="col-lg-4 text-lg-end">
      <div class="dashboard-date-pill"><i class="bi bi-calendar3 me-2"></i><%= new Date().toLocaleDateString('en-IN', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }) %></div>
    </div>
  </div>
</div>

<!-- Dashboard KPIs: deliberately focused on today's live snapshot, not report analytics. -->
<div class="row g-3 mb-4">
  <div class="col-sm-6 col-xl-3"><div class="stat-card stat-orange h-100"><div class="card-body"><div class="d-flex justify-content-between align-items-start"><div><div class="small opacity-75">Today's Meals</div><h2 class="mb-0 mt-2"><%= mealTotals.totalMeals %></h2><div class="small mt-1">Student + guest</div></div><div class="stat-icon"><i class="bi bi-egg-fried"></i></div></div></div></div></div>
  <div class="col-sm-6 col-xl-3"><div class="stat-card stat-green h-100"><div class="card-body"><div class="d-flex justify-content-between align-items-start"><div><div class="small opacity-75">Reservations</div><h2 class="mb-0 mt-2"><%= todayReservations.length %></h2><div class="small mt-1"><%= confirmedCount %> confirmed · <%= completedCount %> completed</div></div><div class="stat-icon"><i class="bi bi-calendar-check"></i></div></div></div></div></div>
  <div class="col-sm-6 col-xl-3"><div class="stat-card stat-blue h-100"><div class="card-body"><div class="d-flex justify-content-between align-items-start"><div><div class="small opacity-75">Guest Meals</div><h2 class="mb-0 mt-2"><%= mealTotals.guestMeals %></h2><div class="small mt-1">Visitors expected today</div></div><div class="stat-icon"><i class="bi bi-people"></i></div></div></div></div></div>
  <div class="col-sm-6 col-xl-3"><div class="stat-card stat-dark h-100"><div class="card-body"><div class="d-flex justify-content-between align-items-start"><div><div class="small opacity-75">Total Students</div><h2 class="mb-0 mt-2"><%= totalStudents %></h2><div class="small mt-1">Registered students</div></div><div class="stat-icon"><i class="bi bi-mortarboard"></i></div></div></div></div></div>
</div>

<div class="row g-4 mb-4">
  <div class="col-lg-8">
    <div class="modern-card bg-white h-100">
      <div class="card-header bg-white p-3 p-md-4 d-flex justify-content-between align-items-center">
        <div><h5 class="mb-1 fw-bold">Today's Meal Flow</h5><div class="small text-muted">See where today's kitchen demand is concentrated.</div></div>
        <span class="dashboard-live-badge"><span></span> Live today</span>
      </div>
      <div class="card-body p-3 p-md-4">
        <div class="row g-3">
          <% [['breakfast','Breakfast','bi-sunrise'],['lunch','Lunch','bi-brightness-high'],['dinner','Dinner','bi-moon-stars']].forEach(function(item) { const s = sessionSummary[item[0]]; const width = mealTotals.totalMeals ? Math.round((s.meals / mealTotals.totalMeals) * 100) : 0; %>
            <div class="col-md-4">
              <div class="session-overview-card">
                <div class="d-flex justify-content-between align-items-start mb-3"><div class="session-overview-icon"><i class="bi <%= item[2] %>"></i></div><span class="small fw-semibold text-muted"><%= s.reservations %> bookings</span></div>
                <h6 class="fw-bold mb-1"><%= item[1] %></h6>
                <div class="display-6 fw-bold"><%= s.meals %></div>
                <div class="small text-muted mb-2">meals to prepare</div>
                <div class="progress" style="height:7px"><div class="progress-bar" role="progressbar" style="width:<%= width %>%"></div></div>
                <div class="small text-muted mt-2"><%= width %>% of today's demand</div>
              </div>
            </div>
          <% }); %>
        </div>
        <div class="dashboard-insight mt-3"><i class="bi bi-lightbulb me-2"></i><strong><%= busiestSession.charAt(0).toUpperCase() + busiestSession.slice(1) %></strong> currently has the highest meal demand. Use this view for quick kitchen preparation decisions.</div>
      </div>
    </div>
  </div>

  <div class="col-lg-4">
    <div class="modern-card bg-white h-100">
      <div class="card-header bg-white p-3 p-md-4"><h5 class="mb-1 fw-bold">Today's Alerts</h5><div class="small text-muted">Things that may need attention.</div></div>
      <div class="card-body d-grid gap-3">
        <div class="dashboard-alert"><div class="alert-icon success"><i class="bi bi-check2-circle"></i></div><div><strong>Reservations ready</strong><div class="small text-muted"><%= confirmedCount %> confirmed bookings awaiting service.</div></div></div>
        <div class="dashboard-alert"><div class="alert-icon info"><i class="bi bi-people"></i></div><div><strong>Guest planning</strong><div class="small text-muted"><%= mealTotals.guestMeals %> guest meals are included in today's count.</div></div></div>
        <div class="dashboard-alert"><div class="alert-icon warning"><i class="bi bi-chat-heart"></i></div><div><strong>Feedback inbox</strong><div class="small text-muted"><%= pendingFeedback %> feedback submissions to review.</div></div></div>
      </div>
    </div>
  </div>
</div>

<div class="row g-4 mb-4">
  <div class="col-lg-7">
    <div class="modern-card bg-white h-100">
      <div class="card-header bg-white p-3 p-md-4"><h5 class="mb-1 fw-bold">Kitchen Preparation</h5><div class="small text-muted">Simple actions for the kitchen team today.</div></div>
      <div class="card-body p-3 p-md-4">
        <div class="row g-3">
          <div class="col-md-4"><div class="prep-card"><div class="prep-number"><%= mealTotals.studentMeals %></div><strong>Student meals</strong><span>standard portions</span></div></div>
          <div class="col-md-4"><div class="prep-card"><div class="prep-number"><%= mealTotals.guestMeals %></div><strong>Guest meals</strong><span>additional portions</span></div></div>
          <div class="col-md-4"><div class="prep-card highlight"><div class="prep-number"><%= mealTotals.totalMeals %></div><strong>Total to prepare</strong><span>today's kitchen target</span></div></div>
        </div>
      </div>
    </div>
  </div>
  <div class="col-lg-5">
    <div class="modern-card bg-white h-100">
      <div class="card-header bg-white p-3 p-md-4"><h5 class="mb-1 fw-bold">Quick Actions</h5><div class="small text-muted">Jump directly into today's workflow.</div></div>
      <div class="card-body d-grid gap-2">
        <a class="quick-action" href="/admin/attendance"><div class="quick-icon"><i class="bi bi-person-check"></i></div><div><strong>Record Attendance</strong><div class="small text-muted">Mark present / no-show</div></div><i class="bi bi-chevron-right ms-auto"></i></a>
        <a class="quick-action" href="/admin/reservations"><div class="quick-icon"><i class="bi bi-calendar-check"></i></div><div><strong>Manage Reservations</strong><div class="small text-muted">Review today's bookings</div></div><i class="bi bi-chevron-right ms-auto"></i></a>
        <a class="quick-action" href="/admin/meals"><div class="quick-icon"><i class="bi bi-egg-fried"></i></div><div><strong>Manage Meals</strong><div class="small text-muted"><%= totalMeals %> meals configured</div></div><i class="bi bi-chevron-right ms-auto"></i></a>
        <a class="quick-action" href="/admin/reports"><div class="quick-icon"><i class="bi bi-file-earmark-bar-graph"></i></div><div><strong>Open Detailed Reports</strong><div class="small text-muted">Filter, analyse and print</div></div><i class="bi bi-chevron-right ms-auto"></i></a>
      </div>
    </div>
  </div>
</div>

<div class="dashboard-footer-note"><i class="bi bi-info-circle me-2"></i>Dashboard shows a live operational snapshot. For date filters, session-wise breakdowns, attendance analysis and printable records, use <a href="/admin/reports">Reports</a>.</div>

<%- include('../partials/footer') %>

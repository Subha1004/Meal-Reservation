<%- include('partials/header') %>
<div class="auth-wrap">
  <div class="premium-card row g-0">
    <div class="col-lg-5 premium-left">
      <div>
        <div class="small text-uppercase fw-bold mb-3" style="letter-spacing:.14em;color:#8d794f">Student Portal</div>
        <h1>Student Registration</h1>
        <p>Create your account and reserve fresh meals before your dining session.</p>
        <div class="mt-4 d-flex flex-column gap-2" style="color:#587066">
          <span><i class="bi bi-check-circle-fill me-2" style="color:#2f6b5a"></i>Reserve breakfast, lunch & dinner</span>
          <span><i class="bi bi-check-circle-fill me-2" style="color:#2f6b5a"></i>Manage your bookings easily</span>
        </div>
      </div>
    </div>
    <div class="col-lg-7 premium-form">
      <div class="d-flex align-items-center gap-2 mb-2"><i class="bi bi-mortarboard" style="font-size:1.5rem;color:#2f6b5a"></i><span class="small fw-bold text-uppercase" style="letter-spacing:.12em;color:#718078">Join us</span></div>
      <h2 class="premium-title mb-2">Create your account</h2>
      <p class="text-muted mb-4">Fill in your student details to get started.</p>
      <form action="/register" method="POST">
        <div class="row g-3">
          <div class="col-md-6"><label>Full Name</label><input type="text" name="name" class="form-control" placeholder="Enter full name" required></div>
          <div class="col-md-6"><label>Roll Number</label><input type="text" name="studentId" class="form-control" placeholder="Enter roll number" required></div>
          <div class="col-md-6"><label>Email</label><input type="email" name="email" class="form-control" placeholder="Enter email address" required></div>
          <div class="col-md-6"><label>Phone</label><input type="tel" name="phone" class="form-control" placeholder="Enter phone number"></div>
          <div class="col-12"><label>Password</label><input type="password" name="password" class="form-control" placeholder="Create a secure password" required></div>
        </div>
        <button class="btn btn-premium w-100 mt-4"><i class="bi bi-person-plus me-2"></i>Register as Student</button>
      </form>
      <div class="auth-links text-center mt-4">Already have an account? <a href="/login">Login here</a></div>
    </div>
  </div>
</div>
<%- include('partials/footer') %>